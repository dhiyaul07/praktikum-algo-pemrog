QPushButton { background-color: #34495E; color: white; border: none; border-radius: 4px; padding: 8px 15px; font-weight: bold; }
QPushButton:hover { background-color: #415B76; }
QTableWidget { background-color: white; border: 1px solid #BDC3C7; gridline-color: #ECF0F1; }
