QPushButton#btnEdit { background-color: #F39C12; }
QPushButton#btnEdit:hover { background-color: #F1C40F; }
QPushButton#btnHapus { background-color: #C0392B; }
QPushButton#btnHapus:hover { background-color: #E74C3C; }
</string></property>
