 <class>LaporanWindow</class>
 <widget class="QMainWindow" name="LaporanWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>900</width><height>560</height></rect></property>
  <property name="windowTitle"><string>Perpustakaan - Laporan Statistik</string></property>
  <property name="styleSheet"><string notr="true">
QMainWindow { background-color: #F8F9FA; }
QLabel#lblTitle { font-size: 18px; font-weight: bold; color: #2C3E50; }
QLabel { font-size: 12px; color: #333; }
QLineEdit, QComboBox, QDateEdit, QSpinBox {
    padding: 6px; border: 1px solid #BDC3C7; border-radius: 4px; background-color: white;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus { border: 1px solid #3498DB; }
QLineEdit:read-only { background-color: #ECF0F1; }
QPushButton { background-color: #34495E; color: white; border: none; border-radius: 4px; padding: 8px 15px; font-weight: bold; }
QPushButton:hover { background-color: #415B76; }
QTableWidget { background-color: white; border: 1px solid #BDC3C7; gridline-color: #ECF0F1; }

QFrame[objectName^="card"] { background-color: white; border: 1px solid #BDC3C7; border-radius: 8px; }
QLabel[objectName^="lblCaption"] { font-size: 12px; color: #7F8C8D; }
QLabel#lblTotalBuku, QLabel#lblPinjamAktif, QLabel#lblTotalDenda { font-size: 24px; font-weight: bold; color: #2C3E50; }
</string></property>
